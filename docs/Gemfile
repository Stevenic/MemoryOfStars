source "https://rubygems.org"

# --- Local preview toolchain ---
# Production is built by GitHub Pages from the branch (Settings → Pages → Deploy
# from a branch → /docs), which uses GitHub's OWN pinned gem environment. This
# Gemfile is only for local preview and does NOT affect the deployed build.
#
# We use modern Jekyll 4 here because the `github-pages` metagem pins Jekyll 3.9
# / Liquid 4.0.3, which call Object#tainted? — a method removed from Ruby in 3.2
# — so that stack cannot run on current Ruby (4.0). Rendering of this site's
# plain templates (kramdown + Liquid + CSS) is equivalent either way.
gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Local server + a few libraries dropped from Ruby's default gems in 3.x / 4.0.
gem "webrick", "~> 1.8"
gem "csv"
gem "base64"
gem "logger"
